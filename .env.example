# Example environment values. Do not put real production secrets here.
#
# Local development can copy this to `.env`. Production-like deployment can
# also use `.env`; replace required placeholders and keep the file untracked.

# 1. Required database values
# POSTGRES_USER is the bootstrap/migration administrator created by the
# PostgreSQL image. Long-running services never receive these credentials.
# POSTGRES_RUNTIME_USER is the separate least-privilege application role.
# Use distinct URI-safe users and strong passwords (for example long base64url values).
POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_migration_admin_user
POSTGRES_PASSWORD=replace_with_strong_migration_admin_password
POSTGRES_RUNTIME_USER=replace_with_runtime_user
POSTGRES_RUNTIME_PASSWORD=replace_with_strong_runtime_password
MIGRATION_DATABASE_URL=postgresql://replace_with_migration_admin_user:replace_with_strong_migration_admin_password@localhost:5432/replace_with_database_name?schema=public
DATABASE_URL=postgresql://replace_with_runtime_user:replace_with_strong_runtime_password@localhost:5432/replace_with_database_name?schema=public

# 2. Common local and deployment values
NODE_ENV=development
PARTSRADAR_PUBLIC_BASE_URL=https://partsradar.net

# Compose binds remain loopback-only unless the deployment intentionally exposes them.
# POSTGRES_IMAGE=postgres:18-alpine
# POSTGRES_BIND_HOST=127.0.0.1
# POSTGRES_PORT=5432
# WEB_BIND_HOST=127.0.0.1
# WEB_PORT=3000

# Local storage paths. Web and crawler already share the repo-local product
# image default; use an absolute path only when intentionally overriding it.
SNAPSHOT_STORAGE_DIR=storage/snapshots
EXTERNAL_FETCH_LOCK_DIR=storage/snapshots/.locks/external-fetch
# PRODUCT_IMAGE_STORAGE_DIR=/absolute/path/to/product-images
# IMAGE_CACHE_INACTIVE_RETENTION_DAYS=30

# 3. Optional feature secrets and public configuration

# Discord admin notification webhook
# Keep real webhook URLs only in untracked `.env` files or deployment secrets.
# DISCORD_ADMIN_WEBHOOK_URL=replace_with_discord_admin_webhook_url

# Discord bot
# Keep real bot tokens only in untracked `.env` files or deployment secrets.
# DISCORD_BOT_TOKEN=replace_with_discord_bot_token
# DISCORD_APPLICATION_ID=replace_with_discord_application_id
# Optional private /status command. Set both values or leave both unset.
# Keep real Discord IDs only in untracked `.env` files or deployment secrets.
# DISCORD_STATUS_GUILD_ID=replace_with_discord_guild_id
# DISCORD_STATUS_OWNER_USER_ID=replace_with_discord_user_id
# Optional bot presence. Activity is displayed as "Watching <text>".
# DISCORD_BOT_ACTIVITY_TEXT=partsradar.net
# DISCORD_BOT_PRESENCE_STATUS=online
# Public install invite should use least privilege:
# https://discord.com/oauth2/authorize?client_id=<DISCORD_APPLICATION_ID>&scope=bot%20applications.commands&permissions=0
# The server renders this public URL at runtime; recreate web after changing it.
# DISCORD_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=<DISCORD_APPLICATION_ID>&scope=bot%20applications.commands&permissions=0

# Cloudflare Tunnel
# Set only on a deployment host that enables the `public-tunnel` profile.
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:replace_with_pinned_version
# CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# 4. Advanced tuning
# Compose and scripts provide the defaults below. Uncomment only an intentional override.

# Web API rate limits
# API_READ_RATE_LIMIT_MAX=120
# API_LIST_RATE_LIMIT_MAX=360
# API_IMAGE_RATE_LIMIT_MAX=1200
# API_RATE_LIMIT_WINDOW_SECONDS=60
# API_RATE_LIMIT_CACHE_SIZE=5000

# Web security headers. These values are passed into the web image build.
# Use report-only first when tightening policy, then rebuild with enforce.
# CSP_MODE=enforce
# CSP_REPORT_URI=https://example.com/csp-report

# Crawler scheduler and source request timing
# CRAWLER_INTERVAL_SECONDS=1800
# CRAWLER_BACKOFF_SECONDS=3600
# CRAWLER_LOCK_RETRY_SECONDS=120
# Raw snapshot mutation lock contention uses a separate short retry policy.
# CRAWLER_LOCK_BUSY_RETRY_SECONDS=45
# CRAWLER_LOCK_BUSY_MAX_RETRIES=5
# CRAWLER_FILTER_SYNC_INTERVAL_SECONDS=604800
# CRAWLER_CATEGORY_DELAY_MS=8000
# IMAGE_RECOVERY_INTERVAL_SECONDS=300
# IMAGE_RECOVERY_BATCH_LIMIT=25
# CRAWLER_NEW_PRODUCT_IMAGE_MIN_DELAY_MS=5000
# CRAWLER_NEW_PRODUCT_IMAGE_MAX_DELAY_MS=12000
# CRAWLER_NEW_PRODUCT_IMAGE_TIMEOUT_MS=15000
# CRAWLER_NEW_PRODUCT_IMAGE_MAX_SOURCE_BYTES=5242880
# SOURCE_IMAGE_FETCH_LOCK_DIR=storage/snapshots/.locks/source-image-fetch
# SOURCE_IMAGE_FETCH_LOCK_STALE_SECONDS=300
# Single-host renewable lease. A dead holder is reclaimed after this many seconds without heartbeat.
# EXTERNAL_FETCH_LOCK_STALE_SECONDS=300
# RAW_SNAPSHOT_CLEANUP_INTERVAL_SECONDS=86400
# Give crawler startup priority after backup recovery or host/container restart.
# RAW_SNAPSHOT_CLEANUP_INITIAL_DELAY_SECONDS=300
# RAW_SNAPSHOT_CLEANUP_LOCK_BUSY_RETRY_SECONDS=60
# RAW_SNAPSHOT_CLEANUP_LOCK_BUSY_MAX_RETRIES=5

# Production smoke and admin alert policy
# SMOKE_PUBLIC_BASE_URL=http://web:3000
# SMOKE_INTERVAL_SECONDS=300
# SMOKE_INITIAL_DELAY_SECONDS=60
# SMOKE_CYCLE_TIMEOUT_MS=30000
# SMOKE_TIMEOUT_MS=5000
# SMOKE_PRODUCT_IMAGE_SAMPLE_SIZE=5
# SMOKE_SOURCE_WARN_AFTER_MINUTES=60
# SMOKE_SOURCE_FAIL_AFTER_MINUTES=120
# SMOKE_CRAWLER_WARN_AFTER_MINUTES=90
# SMOKE_CRAWLER_FAIL_AFTER_MINUTES=180
# SMOKE_RECENT_WINDOW_HOURS=24
# SMOKE_PARSE_ERROR_WARN_COUNT=20
# SMOKE_PARSE_ERROR_FAIL_COUNT=100
# SMOKE_SOURCE_IMAGE_FAILURE_MIN_CONSECUTIVE=3
# SMOKE_SOURCE_IMAGE_FAILURE_WARN_COUNT=100
# SMOKE_SOURCE_IMAGE_FAILURE_FAIL_COUNT=300
# SMOKE_MIN_ACTIVE_PRODUCTS=1
# Product filter quality warns only when both the unclassified count and ratio are reached.
# SMOKE_FILTER_EMPTY_WARN_MIN_COUNT=10
# SMOKE_FILTER_EMPTY_WARN_RATIO=0.005
# SMOKE_MISSING_IMAGE_WARN_COUNT=30
# SMOKE_MISSING_IMAGE_FAIL_COUNT=100
# SMOKE_RAW_SNAPSHOT_NORMAL_RETENTION_DAYS=30
# SMOKE_RAW_SNAPSHOT_ABNORMAL_RETENTION_DAYS=90
# SMOKE_RAW_SNAPSHOT_RETENTION_GRACE_DAYS=2
# SMOKE_RAW_SNAPSHOT_WARN_COUNT=1
# SMOKE_RAW_SNAPSHOT_FAIL_COUNT=100
# Compose enables this check against the crawler's persisted last-known-good state.
# SMOKE_FILTER_SYNC_STATE_FILE=/var/lib/partsradar/snapshots/ops/coolpc-filter-sync-state.json
# SMOKE_CRAWLER_RUNTIME_STATUS_FILE=/var/lib/partsradar/snapshots/ops/crawler-runtime-status.json
# SMOKE_RAW_SNAPSHOT_CLEANUP_RUNTIME_STATUS_FILE=/var/lib/partsradar/snapshots/ops/cleanup-runtime-status.json
# Local default: storage/ops/smoke-discord-state.json
# Compose default: /var/lib/partsradar/snapshots/ops/smoke-discord-state.json
# SMOKE_DISCORD_STATE_FILE=storage/ops/smoke-discord-state.json
# SMOKE_DISCORD_COOLDOWN_SECONDS=43200
# SMOKE_WARNING_PENDING_CYCLES=2
# SMOKE_FILTER_QUALITY_PENDING_CYCLES=3
# SMOKE_RECOVERY_GOOD_CYCLES=2
# SMOKE_FAIL_REMINDER_SECONDS=3600
# SMOKE_PROGRESS_STALE_SECONDS=900

# Discord bot runtime flags and timing
# DISCORD_BOT_REGISTER_COMMANDS_ON_START=true
# DISCORD_FEATURE_PUBLIC_REPORTS_ENABLED=true
# DISCORD_FEATURE_PERSONAL_REPORTS_ENABLED=true
# DISCORD_FEATURE_TARGET_WATCHES_ENABLED=true
# DISCORD_BOT_COMMAND_COOLDOWN_SECONDS=60
# Target-price scan interval and scheduled-report fallback; earlier report due times wake sooner.
# DISCORD_PRICE_REPORT_SCHEDULE_INTERVAL_SECONDS=300
# Keep the official endpoints unless a traceable test environment requires an override.
# DISCORD_API_BASE_URL=https://discord.com/api/v10
# DISCORD_GATEWAY_URL=wss://gateway.discord.gg/?v=10&encoding=json

# Shared ops logger: debug, info, warn, or error.
# LOG_LEVEL=info

# Point Playwright at an existing environment; when unset it starts the local test server.
# E2E_BASE_URL=https://partsradar.net
# Reuse an existing local Next.js build only when the local E2E server is enabled.
# E2E_SKIP_BUILD=1
