# Example environment values. Do not put real production secrets here.
#
# Local development can copy this to `.env`.
# Private server validation and production-like deployment can also use `.env`;
# replace every `replace_with_*` placeholder and keep the file untracked.

NODE_ENV=development

# 1. Required local/dev database values
POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_strong_postgres_password
DATABASE_URL=postgresql://replace_with_database_user:replace_with_strong_postgres_password@localhost:5432/replace_with_database_name?schema=public

# 2. Optional Compose PostgreSQL overrides
# POSTGRES_IMAGE=postgres:18-alpine
# POSTGRES_BIND_HOST=127.0.0.1
# POSTGRES_PORT=5432

# 3. Core web/deploy values
# Keep localhost for SSH tunnel/private validation. Use 0.0.0.0 only when
# intentionally exposing the service.
PARTSRADAR_PUBLIC_BASE_URL=https://partsradar.net
# WEB_BIND_HOST=127.0.0.1
# WEB_PORT=3000

# Optional runtime tuning. Compose and scripts already provide these defaults;
# uncomment only when the deployment intentionally overrides them.
# API_READ_RATE_LIMIT_MAX=120
# API_LIST_RATE_LIMIT_MAX=360
# API_IMAGE_RATE_LIMIT_MAX=1200
# API_RATE_LIMIT_WINDOW_SECONDS=60
# API_RATE_LIMIT_CACHE_SIZE=5000

# Web security headers. CSP is evaluated when the web image is built.
# Use report-only first when tightening policy, then rebuild with enforce.
# CSP_MODE=enforce
# CSP_REPORT_URI=https://example.com/csp-report

# 4. Crawler scheduler values
# CRAWLER_INTERVAL_SECONDS=1800
# CRAWLER_BACKOFF_SECONDS=3600
# CRAWLER_LOCK_RETRY_SECONDS=120
# CRAWLER_CATEGORY_DELAY_MS=8000
# CRAWLER_NEW_PRODUCT_IMAGE_MIN_DELAY_MS=5000
# CRAWLER_NEW_PRODUCT_IMAGE_MAX_DELAY_MS=12000
# CRAWLER_NEW_PRODUCT_IMAGE_TIMEOUT_MS=15000
# CRAWLER_NEW_PRODUCT_IMAGE_MAX_SOURCE_BYTES=5242880
# EXTERNAL_FETCH_LOCK_STALE_SECONDS=43200
# RAW_SNAPSHOT_CLEANUP_INTERVAL_SECONDS=86400

# 5. Ops smoke / monitoring values
# In Compose this can stay internal as http://web:3000, or be changed to the
# public domain when you want the daemon to verify the public tunnel path.
# E2E_BASE_URL=https://partsradar.net
# SMOKE_PUBLIC_BASE_URL=http://web:3000
# SMOKE_INTERVAL_SECONDS=900
# SMOKE_INITIAL_DELAY_SECONDS=60
# SMOKE_TIMEOUT_MS=5000
# SMOKE_PRODUCT_IMAGE_SAMPLE_SIZE=5
# SMOKE_SOURCE_WARN_AFTER_MINUTES=60
# SMOKE_SOURCE_FAIL_AFTER_MINUTES=120
# SMOKE_CRAWLER_WARN_AFTER_MINUTES=90
# SMOKE_CRAWLER_FAIL_AFTER_MINUTES=180
# SMOKE_RECENT_WINDOW_HOURS=24
# SMOKE_PARSE_ERROR_WARN_COUNT=20
# SMOKE_PARSE_ERROR_FAIL_COUNT=100
# SMOKE_INVALID_IMAGE_URL_WARN_COUNT=2000
# SMOKE_MIN_ACTIVE_PRODUCTS=1
# SMOKE_MISSING_IMAGE_WARN_COUNT=200
# SMOKE_MISSING_IMAGE_FAIL_COUNT=500
# SMOKE_RAW_SNAPSHOT_NORMAL_RETENTION_DAYS=30
# SMOKE_RAW_SNAPSHOT_ABNORMAL_RETENTION_DAYS=90
# SMOKE_RAW_SNAPSHOT_RETENTION_GRACE_DAYS=2
# SMOKE_RAW_SNAPSHOT_WARN_COUNT=1
# SMOKE_RAW_SNAPSHOT_FAIL_COUNT=100

# Discord admin notification webhook
# Optional ops notification secret. Keep real webhook URLs only in
# untracked `.env` files or deployment secrets.
# DISCORD_ADMIN_WEBHOOK_URL=replace_with_discord_admin_webhook_url
# Local default: storage/ops/smoke-discord-state.json
# Compose smoke-daemon default: /var/lib/partsradar/snapshots/ops/smoke-discord-state.json
# SMOKE_DISCORD_STATE_FILE=storage/ops/smoke-discord-state.json
# SMOKE_DISCORD_COOLDOWN_SECONDS=3600

# 6. Discord bot personalized notifications
# Optional Discord bot secrets. Keep real bot tokens only in untracked
# `.env` files or deployment secrets.
# DISCORD_BOT_TOKEN=replace_with_discord_bot_token
# DISCORD_APPLICATION_ID=replace_with_discord_application_id
# Public install invite should use least privilege:
# https://discord.com/oauth2/authorize?client_id=<DISCORD_APPLICATION_ID>&scope=bot%20applications.commands&permissions=0
# Optional public website invite button. This value is embedded in the web build.
# NEXT_PUBLIC_DISCORD_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=<DISCORD_APPLICATION_ID>&scope=bot%20applications.commands&permissions=0
# DISCORD_BOT_REGISTER_COMMANDS_ON_START=true
# DISCORD_FEATURE_PUBLIC_REPORTS_ENABLED=true
# DISCORD_FEATURE_PERSONAL_REPORTS_ENABLED=true
# DISCORD_FEATURE_TARGET_WATCHES_ENABLED=true
# DISCORD_PRICE_REPORT_MAX_ITEMS=50
# DISCORD_BOT_COMMAND_COOLDOWN_SECONDS=60
# Target-price scan interval and scheduled-report fallback; earlier report due times wake sooner.
# DISCORD_PRICE_REPORT_SCHEDULE_INTERVAL_SECONDS=300

# 7. Storage paths
SNAPSHOT_STORAGE_DIR=storage/snapshots
EXTERNAL_FETCH_LOCK_DIR=storage/snapshots/.locks/external-fetch

# Product image cache
PRODUCT_IMAGE_STORAGE_DIR=../../storage/product-images

# 8. Cloudflare Tunnel
# Set only on the deployment host when enabling the `public-tunnel` profile.
# Keep placeholder values for local/private validation when the profile is disabled.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:replace_with_pinned_version
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token
