{
  "name": "@partsradar/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    ".": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./price-report": {
      "types": "./src/price-report/index.ts",
      "default": "./src/price-report/index.ts"
    },
    "./discord-privacy": {
      "types": "./src/discord-privacy/index.ts",
      "default": "./src/discord-privacy/index.ts"
    }
  },
  "scripts": {
    "db:configure-runtime-role": "tsx prisma/configure-runtime-role.ts",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@partsradar/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
