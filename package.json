{
  "name": "partsradar-tw",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "build": "pnpm build:web",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:db && pnpm typecheck:crawler",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "pnpm test:core",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:ops": "vitest run --config vitest.ops.config.ts",
    "test:discord": "vitest run --config vitest.discord.config.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "monitor:public-smoke": "pnpm ops:production-smoke -- --public-only",
    "backup:create": "bash scripts/ops/create-backup.sh",
    "backup:restore-drill": "bash scripts/ops/restore-drill.sh",
    "ops:crawl-coolpc-daemon": "pnpm --filter @partsradar/crawler ops:crawl-coolpc-daemon",
    "ops:discord-bot": "pnpm --filter @partsradar/crawler ops:discord-bot",
    "ops:image-cache:backfill": "pnpm --filter @partsradar/crawler ops:image-cache:backfill",
    "ops:image-cache:recovery-daemon": "pnpm --filter @partsradar/crawler ops:image-cache:recovery-daemon",
    "ops:production-smoke": "pnpm --filter @partsradar/crawler ops:production-smoke",
    "ops:production-smoke-daemon": "pnpm --filter @partsradar/crawler ops:production-smoke-daemon",
    "ops:production-smoke:health": "pnpm --filter @partsradar/crawler ops:production-smoke:health",
    "ops:product-vendors:backfill": "pnpm --filter @partsradar/crawler ops:product-vendors:backfill",
    "ops:product-filter-tags:backfill": "pnpm --filter @partsradar/crawler ops:product-filter-tags:backfill",
    "ops:raw-snapshots:cleanup": "pnpm --filter @partsradar/crawler ops:raw-snapshots:cleanup",
    "ops:raw-snapshots:cleanup-daemon": "pnpm --filter @partsradar/crawler ops:raw-snapshots:cleanup-daemon",
    "manual:crawl-coolpc-once": "pnpm --filter @partsradar/crawler manual:crawl-coolpc-once",
    "manual:validate-coolpc-live": "pnpm --filter @partsradar/crawler manual:validate-coolpc-live",
    "db:generate": "pnpm --filter @partsradar/db db:generate",
    "db:migrate": "pnpm --filter @partsradar/db db:migrate",
    "db:deploy": "pnpm --filter @partsradar/db db:deploy",
    "db:seed": "pnpm --filter @partsradar/db db:seed",
    "db:validate": "pnpm --filter @partsradar/db db:validate",
    "dev:web": "pnpm --filter @partsradar/web dev",
    "build:web": "pnpm --filter @partsradar/web build",
    "typecheck:web": "pnpm --filter @partsradar/web typecheck",
    "typecheck:db": "pnpm --filter @partsradar/db typecheck",
    "typecheck:crawler": "pnpm --filter @partsradar/crawler typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.61.1",
    "vitest": "^4.1.7"
  }
}
