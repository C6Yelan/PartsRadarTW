# Local development defaults only. Do not put real production secrets here.

NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://partsradar:partsradar@localhost:5432/partsradar_dev?schema=public

# CoolPC source
COOLPC_BASE_URL=https://www.coolpc.com.tw

# Crawler
CRAWLER_INTERVAL_SECONDS=300
CRAWLER_BACKOFF_SECONDS=3600

# Raw snapshot storage
SNAPSHOT_STORAGE_DIR=storage/snapshots
