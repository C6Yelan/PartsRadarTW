{
  "name": "partsradar-tw",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "build": "pnpm build:web",
    "typecheck": "pnpm typecheck:web",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "dev:web": "pnpm --filter @partsradar/web dev",
    "build:web": "pnpm --filter @partsradar/web build",
    "typecheck:web": "pnpm --filter @partsradar/web typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "vitest": "^4.1.7"
  }
}
