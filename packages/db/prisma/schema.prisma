generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  TWD

  @@map("currency")
}

enum CrawlRunStatus {
  RUNNING             @map("running")
  SUCCESS_CHANGED     @map("success_changed")
  SUCCESS_UNCHANGED   @map("success_unchanged")
  SUCCESS_WITH_ERRORS @map("success_with_errors")
  FETCH_FAILED        @map("fetch_failed")
  SUSPECTED_BLOCK     @map("suspected_block")
  PARSE_FAILED        @map("parse_failed")

  @@map("crawl_run_status")
}

enum CrawlRunCategoryResultStatus {
  SUCCESS_CHANGED   @map("success_changed")
  SUCCESS_UNCHANGED @map("success_unchanged")
  FETCH_FAILED      @map("fetch_failed")
  SUSPECTED_BLOCK   @map("suspected_block")
  PARSE_FAILED      @map("parse_failed")

  @@map("crawl_run_category_result_status")
}

enum CrawlTriggerType {
  SCHEDULED @map("scheduled")
  MANUAL    @map("manual")

  @@map("crawl_trigger_type")
}

enum RawSnapshotContentStatus {
  VALID           @map("valid")
  SUSPECTED_BLOCK @map("suspected_block")
  INVALID         @map("invalid")

  @@map("raw_snapshot_content_status")
}

enum ParseErrorType {
  MISSING_IBUY_TOKEN        @map("missing_ibuy_token")
  MISSING_NAME              @map("missing_name")
  INVALID_IMAGE_URL         @map("invalid_image_url")
  PRICE_PARSE_FAILED        @map("price_parse_failed")
  DUPLICATE_SOURCE_IDENTITY @map("duplicate_source_identity")
  CONTENT_VALIDATION_FAILED @map("content_validation_failed")

  @@map("parse_error_type")
}

enum DiscordPriceReportInterval {
  DAILY     @map("daily")
  EVERY_12H @map("every_12h")
  EVERY_6H  @map("every_6h")

  @@map("discord_price_report_interval")
}

enum DiscordPriceReportWindow {
  HOURS_24 @map("24h")
  HOURS_12 @map("12h")
  HOURS_6  @map("6h")

  @@map("discord_price_report_window")
}

enum DiscordPriceReportScope {
  ALL       @map("all")
  WATCHLIST @map("watchlist")

  @@map("discord_price_report_scope")
}

enum DiscordPriceReportDeliveryState {
  ACTIVE                   @map("active")
  PAUSED_PERMANENT_FAILURE @map("paused_permanent_failure")
  PAUSED_RETRY_EXHAUSTED   @map("paused_retry_exhausted")
  PAUSED_PARTIAL_DELIVERY  @map("paused_partial_delivery")

  @@map("discord_price_report_delivery_state")
}

enum DiscordNotificationKind {
  PRICE_REPORT_NOW       @map("price_report_now")
  SCHEDULED_PRICE_REPORT @map("scheduled_price_report")
  TARGET_PRICE           @map("target_price")

  @@map("discord_notification_kind")
}

enum DiscordNotificationStatus {
  SENT         @map("sent")
  SKIPPED      @map("skipped")
  FAILED       @map("failed")
  RATE_LIMITED @map("rate_limited")

  @@map("discord_notification_status")
}

enum DiscordDeliveryErrorCategory {
  PERMISSIONS         @map("permissions")
  DM_UNAVAILABLE      @map("dm_unavailable")
  RATE_LIMITED        @map("rate_limited")
  INTERACTION_EXPIRED @map("interaction_expired")
  TRANSPORT           @map("transport")
  PROVIDER            @map("provider")

  @@map("discord_delivery_error_category")
}

enum DiscordPublicReportAccessStatus {
  ACTIVE                @map("active")
  PAUSED_PERMISSION     @map("paused_permission")
  DISABLED_CHANNEL_GONE @map("disabled_channel_gone")
  DISABLED_BOT_REMOVED  @map("disabled_bot_removed")

  @@map("discord_public_report_access_status")
}

enum DiscordPrivacyRequestType {
  INSPECT @map("inspect")
  ERASE   @map("erase")

  @@map("discord_privacy_request_type")
}

model SourceCategory {
  id              String                   @id @default(uuid()) @db.Uuid
  igrp            Int
  sourceName      String                   @map("source_name")
  displayName     String                   @map("display_name")
  enabled         Boolean                  @default(true)
  lastCheckedAt   DateTime?                @map("last_checked_at") @db.Timestamptz(6)
  lastSuccessAt   DateTime?                @map("last_success_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  products        Product[]
  rawSnapshots    RawSnapshot[]
  crawlRunResults CrawlRunCategoryResult[]
  parseErrors     ParseError[]

  @@unique([igrp], map: "source_categories_igrp_key")
  @@index([enabled], map: "source_categories_enabled_idx")
  @@map("source_categories")
}

model Product {
  id                       String                        @id @default(uuid()) @db.Uuid
  sourceCategoryId         String                        @map("source_category_id") @db.Uuid
  sourceCategory           SourceCategory                @relation(fields: [sourceCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ibuyToken                String                        @map("ibuy_token")
  name                     String                        @db.Text
  normalizedName           String                        @map("normalized_name") @db.Text
  vendorSlug               String?                       @map("vendor_slug") @db.Text
  vendorName               String?                       @map("vendor_name") @db.Text
  filterTags               String[]                      @default([]) @map("filter_tags")
  primaryImageUrl          String?                       @map("primary_image_url") @db.Text
  primaryImageCheckedAt    DateTime?                     @map("primary_image_checked_at") @db.Timestamptz(6)
  imageCachedAt            DateTime?                     @map("image_cached_at") @db.Timestamptz(6)
  imageCacheCheckedAt      DateTime?                     @map("image_cache_checked_at") @db.Timestamptz(6)
  imageCacheFailureCount   Int                           @default(0) @map("image_cache_failure_count")
  imageCacheLastError      String?                       @map("image_cache_last_error") @db.Text
  imageCacheLastErrorKind  String?                       @map("image_cache_last_error_kind") @db.Text
  imageCacheLastHttpStatus Int?                          @map("image_cache_last_http_status")
  imageCacheFailureSince   DateTime?                     @map("image_cache_failure_since") @db.Timestamptz(6)
  imageCacheLastSuccessAt  DateTime?                     @map("image_cache_last_success_at") @db.Timestamptz(6)
  imageCacheNextRetryAt    DateTime?                     @map("image_cache_next_retry_at") @db.Timestamptz(6)
  sourceUrl                String                        @map("source_url") @db.Text
  isActive                 Boolean                       @default(true) @map("is_active")
  isExcluded               Boolean                       @default(false) @map("is_excluded")
  exclusionReason          ProductExclusionReason?       @map("exclusion_reason")
  missingSince             DateTime?                     @map("missing_since") @db.Timestamptz(6)
  missingSeenCount         Int                           @default(0) @map("missing_seen_count")
  firstSeenAt              DateTime                      @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt               DateTime                      @map("last_seen_at") @db.Timestamptz(6)
  createdAt                DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  currentPrice             CurrentPrice?
  priceSnapshots           PriceSnapshot[]
  discordTargetWatches     DiscordTargetPriceWatch[]
  discordDeliveries        DiscordNotificationDelivery[]
  facetEligibleTags        ProductFacetEligibleProduct[]

  @@unique([sourceCategoryId, ibuyToken], map: "products_source_category_id_ibuy_token_key")
  @@index([sourceCategoryId], map: "products_source_category_id_idx")
  @@index([sourceCategoryId, vendorSlug], map: "products_source_category_id_vendor_slug_idx")
  @@index([filterTags], type: Gin, map: "products_filter_tags_idx")
  @@index([isActive], map: "products_is_active_idx")
  @@index([isExcluded], map: "products_is_excluded_idx")
  @@index([lastSeenAt], map: "products_last_seen_at_idx")
  @@index([primaryImageCheckedAt], map: "products_primary_image_checked_at_idx")
  @@index([imageCacheCheckedAt], map: "products_image_cache_checked_at_idx")
  @@index([imageCacheNextRetryAt], map: "products_image_cache_next_retry_at_idx")
  @@map("products")
}

model ProductFacetEligibleProduct {
  igrp      Int
  tag       String  @db.Text
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([igrp, tag, productId], map: "product_facet_eligible_products_pkey")
  @@index([productId], map: "product_facet_eligible_products_product_id_idx")
  @@map("product_facet_eligible_products")
}

enum ProductExclusionReason {
  misclassified_bundle_product
  conditional_add_on
}

model PriceSnapshot {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  price         Int
  currency      Currency      @default(TWD)
  capturedAt    DateTime      @map("captured_at") @db.Timestamptz(6)
  crawlRunId    String        @map("crawl_run_id") @db.Uuid
  crawlRun      CrawlRun      @relation(fields: [crawlRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rawSnapshotId String?       @map("raw_snapshot_id") @db.Uuid
  rawSnapshot   RawSnapshot?  @relation(fields: [rawSnapshotId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  currentPrice  CurrentPrice? @relation("CurrentPriceSnapshot")

  @@unique([id, productId], map: "price_snapshots_id_product_id_key")
  @@index([capturedAt, id], map: "price_snapshots_captured_at_id_idx")
  @@index([productId, capturedAt(sort: Desc), id(sort: Desc)], map: "price_snapshots_product_id_captured_at_id_idx")
  @@index([crawlRunId, capturedAt, id], map: "price_snapshots_crawl_run_id_captured_at_id_idx")
  @@index([rawSnapshotId], map: "price_snapshots_raw_snapshot_id_idx")
  @@map("price_snapshots")
}

model CurrentPrice {
  productId       String        @id @map("product_id") @db.Uuid
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  priceSnapshotId String        @unique(map: "current_prices_price_snapshot_id_key") @map("price_snapshot_id") @db.Uuid
  priceSnapshot   PriceSnapshot @relation("CurrentPriceSnapshot", fields: [priceSnapshotId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Cascade)
  lastSeenAt      DateTime      @map("last_seen_at") @db.Timestamptz(6)
  priceChangedAt  DateTime      @map("price_changed_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([priceSnapshotId, productId], map: "current_prices_price_snapshot_id_product_id_key")
  @@index([lastSeenAt], map: "current_prices_last_seen_at_idx")
  @@map("current_prices")
}

model DiscordPriceReportSetting {
  id                   String                     @id @default(uuid()) @db.Uuid
  discordUserId        String                     @unique(map: "discord_price_report_settings_discord_user_id_key") @map("discord_user_id") @db.Text
  interval             DiscordPriceReportInterval
  window               DiscordPriceReportWindow
  scope                DiscordPriceReportScope    @default(ALL)
  timezone             String                     @default("Asia/Taipei") @db.Text
  maxItems             Int                        @default(50) @map("max_items")
  categoryIgrps        Int[]                      @default([]) @map("category_igrps")
  productKeyword       String?                    @map("product_keyword") @db.Text
  includePriceDrops    Boolean                    @default(true) @map("include_price_drops")
  includePriceRises    Boolean                    @default(true) @map("include_price_rises")
  includeNewProducts   Boolean                    @default(true) @map("include_new_products")
  enabled              Boolean                    @default(true)
  deliveryState        DiscordPriceReportDeliveryState @default(ACTIVE) @map("delivery_state")
  consecutiveDeliveryFailures Int                 @default(0) @map("consecutive_delivery_failures")
  deliveryClaimedAt    DateTime?                  @map("delivery_claimed_at") @db.Timestamptz(6)
  disabledAt           DateTime?                  @map("disabled_at") @db.Timestamptz(6)
  nextSendAt           DateTime?                  @map("next_send_at") @db.Timestamptz(6)
  lastSentAt           DateTime?                  @map("last_sent_at") @db.Timestamptz(6)
  notificationCursorAt DateTime?                  @map("notification_cursor_at") @db.Timestamptz(6)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveries           DiscordNotificationDelivery[]

  @@index([enabled, nextSendAt], map: "discord_price_report_settings_enabled_next_send_at_idx")
  @@index([enabled, deliveryState, nextSendAt, deliveryClaimedAt], map: "discord_price_report_settings_delivery_due_idx")
  @@map("discord_price_report_settings")
}

model DiscordTargetPriceWatch {
  id                    String                        @id @default(uuid()) @db.Uuid
  discordUserId         String                        @map("discord_user_id") @db.Text
  productId             String                        @map("product_id") @db.Uuid
  product               Product                       @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  targetPrice           Int                           @map("target_price")
  currency              Currency                      @default(TWD)
  enabled               Boolean                       @default(true)
  disabledAt            DateTime?                     @map("disabled_at") @db.Timestamptz(6)
  lastNotifiedAt        DateTime?                     @map("last_notified_at") @db.Timestamptz(6)
  notificationClaimedAt DateTime?                     @map("notification_claimed_at") @db.Timestamptz(6)
  notificationCursorAt  DateTime?                     @map("notification_cursor_at") @db.Timestamptz(6)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveries            DiscordNotificationDelivery[]

  @@unique([discordUserId, productId], map: "discord_target_price_watches_discord_user_id_product_id_key")
  @@index([discordUserId, enabled], map: "discord_target_price_watches_user_enabled_idx")
  @@index([productId, enabled], map: "discord_target_price_watches_product_enabled_idx")
  @@index([enabled, lastNotifiedAt, notificationClaimedAt], map: "discord_target_price_watches_notification_due_idx")
  @@index([updatedAt, id], map: "discord_target_price_watches_pending_scan_idx", where: { enabled: true, lastNotifiedAt: null })
  @@map("discord_target_price_watches")
}

model DiscordTargetPriceNotificationScanState {
  id                  Int       @id @default(1)
  cursorUpdatedAt     DateTime? @map("cursor_updated_at") @db.Timestamptz(6)
  cursorWatchId       String?   @map("cursor_watch_id") @db.Uuid
  roundUpperUpdatedAt DateTime? @map("round_upper_updated_at") @db.Timestamptz(6)
  roundUpperWatchId   String?   @map("round_upper_watch_id") @db.Uuid
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("discord_target_price_notification_scan_state")
}

model DiscordNotificationDelivery {
  id                 String                        @id @default(uuid()) @db.Uuid
  discordUserId      String                        @map("discord_user_id") @db.Text
  kind               DiscordNotificationKind
  status             DiscordNotificationStatus
  productId          String?                       @map("product_id") @db.Uuid
  product            Product?                      @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  targetPriceWatchId String?                       @map("target_price_watch_id") @db.Uuid
  targetPriceWatch   DiscordTargetPriceWatch?      @relation(fields: [targetPriceWatchId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  priceReportSettingId String?                      @map("price_report_setting_id") @db.Uuid
  priceReportSetting   DiscordPriceReportSetting?   @relation(fields: [priceReportSettingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dedupeKey          String?                       @unique(map: "discord_notification_deliveries_dedupe_key_key") @map("dedupe_key") @db.Text
  itemCount          Int                           @default(0) @map("item_count")
  messageCount       Int                           @default(0) @map("message_count")
  errorMessage       String?                       @map("error_message") @db.Text
  errorCategory      DiscordDeliveryErrorCategory? @map("error_category")
  httpStatus         Int?                          @map("http_status")
  providerErrorCode  Int?                          @map("provider_error_code")
  deliveredAt        DateTime?                     @map("delivered_at") @db.Timestamptz(6)
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([discordUserId, createdAt], map: "discord_notification_deliveries_user_created_at_idx")
  @@index([kind, status, createdAt], map: "discord_notification_deliveries_kind_status_created_at_idx")
  @@index([productId], map: "discord_notification_deliveries_product_id_idx")
  @@index([targetPriceWatchId], map: "discord_notification_deliveries_target_watch_id_idx")
  @@index([priceReportSettingId], map: "discord_notification_deliveries_price_report_setting_id_idx")
  @@map("discord_notification_deliveries")
}

model DiscordPublicPriceReportDelivery {
  id                String                        @id @default(uuid()) @db.Uuid
  crawlRunId        String                        @map("crawl_run_id") @db.Uuid
  crawlRun          CrawlRun                      @relation(fields: [crawlRunId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  channelId         String                        @map("channel_id") @db.Text
  publicPriceReportSettingId String?               @map("public_price_report_setting_id") @db.Uuid
  publicPriceReportSetting   DiscordPublicPriceReportSetting? @relation(fields: [publicPriceReportSettingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  status            DiscordNotificationStatus
  itemCount         Int                           @default(0) @map("item_count")
  messageCount      Int                           @default(0) @map("message_count")
  errorMessage      String?                       @map("error_message") @db.Text
  errorCategory     DiscordDeliveryErrorCategory? @map("error_category")
  httpStatus        Int?                          @map("http_status")
  providerErrorCode Int?                          @map("provider_error_code")
  deliveredAt       DateTime?                     @map("delivered_at") @db.Timestamptz(6)
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([crawlRunId, channelId], map: "discord_public_report_deliveries_run_channel_key")
  @@index([channelId, createdAt], map: "discord_public_price_report_deliveries_channel_created_at_idx")
  @@index([publicPriceReportSettingId], map: "discord_public_price_report_deliveries_setting_id_idx")
  @@index([status, createdAt], map: "discord_public_price_report_deliveries_status_created_at_idx")
  @@map("discord_public_price_report_deliveries")
}

model DiscordPublicPriceReportSetting {
  id                        String                          @id @default(uuid()) @db.Uuid
  discordGuildId            String                          @unique(map: "discord_public_price_report_settings_guild_id_key") @map("discord_guild_id") @db.Text
  channelId                 String                          @map("channel_id") @db.Text
  maxItems                  Int                             @default(50) @map("max_items")
  categoryIgrps             Int[]                           @default([]) @map("category_igrps")
  productKeyword            String?                         @map("product_keyword") @db.Text
  includePriceDrops         Boolean                         @default(true) @map("include_price_drops")
  includePriceRises         Boolean                         @default(true) @map("include_price_rises")
  includeNewProducts        Boolean                         @default(false) @map("include_new_products")
  enabled                   Boolean                         @default(true)
  accessStatus              DiscordPublicReportAccessStatus @default(ACTIVE) @map("access_status")
  disabledAt               DateTime?                       @map("disabled_at") @db.Timestamptz(6)
  purgeAfter               DateTime?                       @map("purge_after") @db.Timestamptz(6)
  lastDiscordErrorCode      Int?                            @map("last_discord_error_code")
  lastAccessCheckedAt       DateTime?                       @map("last_access_checked_at") @db.Timestamptz(6)
  consecutiveAccessFailures Int                              @default(0) @map("consecutive_access_failures")
  retryNotBefore            DateTime?                       @map("retry_not_before") @db.Timestamptz(6)
  notificationCursorAt      DateTime?                       @map("notification_cursor_at") @db.Timestamptz(6)
  createdByDiscordUserId    String?                         @map("created_by_discord_user_id") @db.Text
  updatedByDiscordUserId    String?                         @map("updated_by_discord_user_id") @db.Text
  createdAt                 DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveries               DiscordPublicPriceReportDelivery[]

  @@index([enabled, accessStatus, retryNotBefore], map: "discord_public_report_settings_delivery_due_idx")
  @@index([purgeAfter], map: "discord_public_report_settings_purge_after_idx")
  @@map("discord_public_price_report_settings")
}

model DiscordPrivacyVerificationRequest {
  id             String                    @id @default(uuid()) @db.Uuid
  requestType    DiscordPrivacyRequestType @map("request_type")
  discordUserId  String?                   @map("discord_user_id") @db.Text
  codeDigest     String?                   @map("code_digest") @db.Text
  expiresAt      DateTime                  @map("expires_at") @db.Timestamptz(6)
  attemptCount   Int                       @default(0) @map("attempt_count")
  maxAttempts    Int                       @default(5) @map("max_attempts")
  verifiedAt     DateTime?                 @map("verified_at") @db.Timestamptz(6)
  consumedAt     DateTime?                 @map("consumed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([discordUserId, createdAt], map: "discord_privacy_verification_user_created_at_idx")
  @@index([expiresAt], map: "discord_privacy_verification_expires_at_idx")
  @@map("discord_privacy_verification_requests")
}

model CrawlRun {
  id                          String                             @id @default(uuid()) @db.Uuid
  status                      CrawlRunStatus                     @default(RUNNING)
  startedAt                   DateTime                           @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt                  DateTime?                          @map("finished_at") @db.Timestamptz(6)
  triggerType                 CrawlTriggerType                   @map("trigger_type")
  errorMessage                String?                            @map("error_message") @db.Text
  backoffUntil                DateTime?                          @map("backoff_until") @db.Timestamptz(6)
  createdAt                   DateTime                           @default(now()) @map("created_at") @db.Timestamptz(6)
  categoryResults             CrawlRunCategoryResult[]
  rawSnapshots                RawSnapshot[]
  priceSnapshots              PriceSnapshot[]
  parseErrors                 ParseError[]
  publicPriceReportDeliveries DiscordPublicPriceReportDelivery[]

  @@index([startedAt], map: "crawl_runs_started_at_idx")
  @@index([status], map: "crawl_runs_status_idx")
  @@index([backoffUntil], map: "crawl_runs_backoff_until_idx")
  @@map("crawl_runs")
}

model CrawlRunCategoryResult {
  id               String                       @id @default(uuid()) @db.Uuid
  crawlRunId       String                       @map("crawl_run_id") @db.Uuid
  crawlRun         CrawlRun                     @relation(fields: [crawlRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceCategoryId String                       @map("source_category_id") @db.Uuid
  sourceCategory   SourceCategory               @relation(fields: [sourceCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status           CrawlRunCategoryResultStatus
  rawSnapshotId    String?                      @map("raw_snapshot_id") @db.Uuid
  rawSnapshot      RawSnapshot?                 @relation(fields: [rawSnapshotId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  errorMessage     String?                      @map("error_message") @db.Text
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([crawlRunId, sourceCategoryId], map: "crawl_run_category_results_crawl_run_id_source_category_id_key")
  @@index([crawlRunId], map: "crawl_run_category_results_crawl_run_id_idx")
  @@index([sourceCategoryId], map: "crawl_run_category_results_source_category_id_idx")
  @@index([rawSnapshotId], map: "crawl_run_category_results_raw_snapshot_id_idx")
  @@map("crawl_run_category_results")
}

model RawSnapshot {
  id                    String                   @id @default(uuid()) @db.Uuid
  crawlRunId            String                   @map("crawl_run_id") @db.Uuid
  crawlRun              CrawlRun                 @relation(fields: [crawlRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceCategoryId      String                   @map("source_category_id") @db.Uuid
  sourceCategory        SourceCategory           @relation(fields: [sourceCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  url                   String                   @db.Text
  fetchedAt             DateTime                 @map("fetched_at") @db.Timestamptz(6)
  httpStatus            Int?                     @map("http_status")
  fetchError            String?                  @map("fetch_error") @db.Text
  contentStatus         RawSnapshotContentStatus @map("content_status")
  contentHash           String?                  @map("content_hash")
  parsedResultHash      String?                  @map("parsed_result_hash")
  compressedHtmlPath    String?                  @map("compressed_html_path") @db.Text
  duplicateOfSnapshotId String?                  @map("duplicate_of_snapshot_id") @db.Uuid
  duplicateOfSnapshot   RawSnapshot?             @relation("RawSnapshotDuplicates", fields: [duplicateOfSnapshotId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  duplicatedSnapshots   RawSnapshot[]            @relation("RawSnapshotDuplicates")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  categoryResults       CrawlRunCategoryResult[]
  priceSnapshots        PriceSnapshot[]
  parseErrors           ParseError[]

  @@index([sourceCategoryId, fetchedAt], map: "raw_snapshots_source_category_id_fetched_at_idx")
  @@index([contentHash], map: "raw_snapshots_content_hash_idx")
  @@index([crawlRunId], map: "raw_snapshots_crawl_run_id_idx")
  @@index([duplicateOfSnapshotId], map: "raw_snapshots_duplicate_of_snapshot_id_idx")
  @@map("raw_snapshots")
}

model ParseError {
  id               String         @id @default(uuid()) @db.Uuid
  crawlRunId       String         @map("crawl_run_id") @db.Uuid
  crawlRun         CrawlRun       @relation(fields: [crawlRunId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rawSnapshotId    String?        @map("raw_snapshot_id") @db.Uuid
  rawSnapshot      RawSnapshot?   @relation(fields: [rawSnapshotId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sourceCategoryId String         @map("source_category_id") @db.Uuid
  sourceCategory   SourceCategory @relation(fields: [sourceCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  errorType        ParseErrorType @map("error_type")
  message          String         @db.Text
  rawName          String?        @map("raw_name") @db.Text
  rawPriceText     String?        @map("raw_price_text")
  rawToken         String?        @map("raw_token")
  rawImageUrl      String?        @map("raw_image_url") @db.Text
  fingerprint      String?        @unique(map: "parse_errors_fingerprint_key") @db.VarChar(64)
  occurrenceCount  Int            @default(1) @map("occurrence_count")
  lastSeenAt       DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([crawlRunId], map: "parse_errors_crawl_run_id_idx")
  @@index([rawSnapshotId], map: "parse_errors_raw_snapshot_id_idx")
  @@index([sourceCategoryId, createdAt], map: "parse_errors_source_category_id_created_at_idx")
  @@index([errorType], map: "parse_errors_error_type_idx")
  @@index([errorType, lastSeenAt], map: "parse_errors_error_type_last_seen_at_idx")
  @@map("parse_errors")
}
